{
  "name": "monarch-actions-switch-account",
  "version": "2.0.0",
  "private": true,
  "description": "TypeScript template action",
  "main": "lib/main.js",
  "scripts": {
    "build": "tsc",
    "format": "prettier --write '**/*.ts'",
    "format-check": "prettier --check '**/*.ts'",
    "lint": "eslint src/**/*.ts",
    "package": "ncc build --source-map --license licenses.txt",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "all": "npm run build && npm run format && npm run lint && npm run package && npm run test:coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/actions/typescript-action.git"
  },
  "keywords": [
    "actions",
    "node",
    "setup"
  ],
  "author": "jwj019",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@aws-sdk/client-ssm": "^3.901.0",
    "@aws-sdk/client-sts": "^3.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@aws-sdk/types": "^3.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^24.0.14",
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "@typescript-eslint/parser": "^8.2.0",
    "@vercel/ncc": "^0.38.0",
    "eslint": "^9.31.0",
    "eslint-plugin-github": "^6.0.0",
    "eslint-plugin-jest": "^28.8.0",
    "eslint-plugin-prettier": "^4.2.3",
    "jest": "^29.7.0",
    "js-yaml": "^4.1.0",
    "prettier": "3.6.2",
    "ts-jest": "^29.4.0",
    "typescript": "^5.5.4"
  },
  "bugs": {
    "url": "https://github.com/actions/typescript-action/issues"
  },
  "homepage": "https://github.com/actions/typescript-action#readme",
  "directories": {
    "lib": "lib"
  }
}
