{
  "name": "monarch-actions-switch-account",
  "version": "2.0.0",
  "private": true,
  "description": "TypeScript template action",
  "main": "lib/main.js",
  "scripts": {
    "format": "prettier --log-level warn --cache --write src/",
    "compile": "npm run format && npm run lint && tsc && npm run package",
    "compile-test": "npm run compile && npm test",
    "lint": "eslint ./src",
    "package": "ncc build --source-map --license licenses.txt",
    "test": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/actions/typescript-action.git"
  },
  "keywords": [
    "actions",
    "node",
    "setup"
  ],
  "author": "jwj019",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^2.0.3",
    "@aws-sdk/client-ssm": "^3.0.0",
    "@aws-sdk/client-sts": "^3.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@aws-sdk/types": "^3.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.14",
    "@vercel/ncc": "^0.38.0",
    "eslint": "^10.8.0",
    "eslint-plugin-github": "^6.1.2",
    "eslint-plugin-jest": "^29.16.0",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^30.4.2",
    "js-yaml": "^4.1.0",
    "prettier": "3.6.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5.5.4"
  },
  "bugs": {
    "url": "https://github.com/actions/typescript-action/issues"
  },
  "homepage": "https://github.com/actions/typescript-action#readme",
  "directories": {
    "lib": "lib"
  },
  "overrides": {
    "brace-expansion": "5.0.9"
  }
}
